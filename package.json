{
    "name":  "dsh-ths-dashboard",
    "version":  "0.1.0",
    "description":  "DSH sidebar dashboard for a Tonghuashun simulated account and local backtest replay, with positions, K-lines, MA5/MA10, MACD, money flow and five-level order book",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "python",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-sidebar",
                                              "@deepseek-ai/dsh-client-ui-layout"
                                          ],
                               "platform":  "web"
                           }
            },
    "license":  "MIT",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "trading",
                     "stock",
                     "ths",
                     "dashboard",
                     "market-data",
                     "backtest"
                 ],
    "engines":  {
                    "node":  "\u003e=22"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/zhangchenyuan21-create/dsh-ths-dashboard.git"
                   },
    "homepage":  "https://github.com/zhangchenyuan21-create/dsh-ths-dashboard",
    "bugs":  {
                 "url":  "https://github.com/zhangchenyuan21-create/dsh-ths-dashboard/issues"
             },
    "author":  "K1294"
}